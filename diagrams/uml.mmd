classDiagram
    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet) None
        +get_pet(name) Pet
        +get_all_tasks() list~Task~
        +to_dict() dict
        +from_dict(data) Owner
        +save_to_json(path) None
        +load_from_json(path) Owner
        +load_or_create(name, path) Owner
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task) None
        +get_tasks() list~Task~
        +remove_task(task) None
        +complete_task(task) Task
        +to_dict() dict
        +from_dict(data) Pet
    }

    class Task {
        +str description
        +str time
        +str frequency
        +date due_date
        +bool completed
        +str pet_name
        +int duration_minutes
        +str priority
        +start_minutes int
        +end_time str
        +mark_complete() Task
        +to_dict() dict
        +from_dict(data) Task
    }

    class Scheduler {
        +Owner owner
        +get_todays_schedule() list~Task~
        +sort_by_time(tasks) list~Task~
        +sort_by_priority(tasks) list~Task~
        +filter_tasks(pet_name, completed) list~Task~
        +detect_conflicts() list~str~
        +find_next_available_slot(duration_minutes, day, earliest, latest) str
        +build_daily_plan(day, earliest, latest) list~PlanItem~
    }

    class PlanItem {
        +Task task
        +str start
        +str end
        +bool moved
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Task : has
    Scheduler --> Owner : organizes tasks for
    Scheduler ..> PlanItem : builds
    PlanItem --> Task : wraps
    Task ..> Task : creates next occurrence
